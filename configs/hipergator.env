# Shared Bash configuration for HiPerGator submission and worker scripts.
# Override these variables explicitly before submission when needed.
export PRONTOQA_PROJECT_ROOT="${PRONTOQA_PROJECT_ROOT:-/blue/fsu-compsci-dept/jh24o.fsu/opd-mechanism}"
export PRONTOQA_DATA_ROOT="${PRONTOQA_DATA_ROOT:-${PRONTOQA_PROJECT_ROOT}/data/prontoqa_v0}"
export PRONTOQA_LOG_ROOT="${PRONTOQA_LOG_ROOT:-${PRONTOQA_PROJECT_ROOT}/logs}"
export PRONTOQA_CONDA_ENV="${PRONTOQA_CONDA_ENV:-${PRONTOQA_PROJECT_ROOT}/envs/opd}"
export PRONTOQA_CONDA_MODULE="${PRONTOQA_CONDA_MODULE:-conda}"
